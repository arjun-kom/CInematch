# ---- Project name (change these two lines to rename the project) ----
APP_NAME=CineMatch
APP_TAGLINE=Personalised Movie Recommendation System using MongoDB

MONGO_DB=cinematch
# Login sessions expire after this many days (TTL index deletes them)
SESSION_DAYS=7
# Create 60 demo users with ratings + the "demo" account on first start
SEED_DEMO_USERS=true

# ---- Ports on your computer (change if one is busy) ----
WEB_PORT=8090
API_PORT=8010
MONGO_PORT=27019
